+/// Add what a posted activation opened or closed to a click result's text and
+/// structured content (`windows: {opened, closed}`).
+fn append_window_changes(
+    mut result: ToolResult,
+    changes: &crate::uia::activate::WindowChanges,
+    pid: u32,
+) -> ToolResult {
+    let sentence = changes.sentence(pid);
+    if let Some(cua_driver_core::protocol::Content::Text { text, .. }) = result.content.first_mut() {
+        text.push(' ');
+        text.push_str(&sentence);
+    }
+    if let Some(Value::Object(map)) = result.structured_content.as_mut() {
+        map.insert("windows".into(), changes.json());
+    }
+    result
+}
