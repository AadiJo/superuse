+/// Post one left click (move, down, up) at **screen** coordinates to the
+/// deepest child of `root` there, back to back. For classic message-loop
+/// windows (see `uia::activate`): they handle the queued messages in order, so
+/// [`post_click_screen`]'s press delay and its foreground watch for WebView
+/// hosts only add latency.
+pub fn post_left_click_screen_now(root: u64, sx: i32, sy: i32) -> Result<()> {
+    let (target, client) = deepest_child(HWND(root as *mut _), POINT { x: sx, y: sy });
+    if let Some(msg) = crate::input::post_message_blocked_by_uipi(target.0 as u64) {
+        anyhow::bail!(msg);
+    }
+    let lparam = make_lparam(client.x, client.y);
+    unsafe {
+        PostMessageW(target, WM_MOUSEMOVE, WPARAM(0), lparam)?;
+        PostMessageW(target, WM_LBUTTONDOWN, WPARAM(MK_LBUTTON as usize), lparam)?;
+        PostMessageW(target, WM_LBUTTONUP, WPARAM(0), lparam)?;
+    }
+    Ok(())
+}
