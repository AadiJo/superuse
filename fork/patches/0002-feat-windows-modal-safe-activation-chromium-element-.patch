+/// [`post_key`] for apps that read modifiers with `GetKeyState` (WinForms
+/// shortcuts, `TranslateAccelerator`): posted `WM_KEYDOWN(VK_CONTROL)` does
+/// not change the key state those read, so the shortcut silently became a
+/// plain key. This thread attaches to the target thread's input for the
+/// call, sets the shared keyboard state to hold `modifiers` while the posted
+/// key is handled, then restores it and detaches (the technique AutoHotkey's
+/// ControlSend uses). No foreground change and no system-wide key state.
+pub fn post_key_with_modifier_state(hwnd: u64, key: &str, modifiers: &[&str]) -> Result<()> {
+    use windows::Win32::System::Threading::{AttachThreadInput, GetCurrentThreadId};
+    use windows::Win32::UI::Input::KeyboardAndMouse::{
+        GetKeyboardState, SetKeyboardState, VK_LCONTROL, VK_LMENU, VK_LSHIFT, VK_LWIN, VK_MENU,
+        VK_SHIFT,
+    };
+    use windows::Win32::UI::WindowsAndMessaging::{PeekMessageW, MSG, PM_NOREMOVE};
+
+    let their_thread = unsafe { GetWindowThreadProcessId(HWND(hwnd as *mut _), None) };
+    if their_thread == 0 {
+        bail!("post_key_with_modifier_state: window 0x{hwnd:x} has no thread");
+    }
+    let my_thread = unsafe { GetCurrentThreadId() };
+    // AttachThreadInput needs a message queue on both threads.
+    let mut msg = MSG::default();
+    unsafe {
+        let _ = PeekMessageW(&mut msg, None, 0, 0, PM_NOREMOVE);
+    }
+    if !unsafe { AttachThreadInput(my_thread, their_thread, TRUE) }.as_bool() {
+        bail!("AttachThreadInput to the target thread failed");
+    }
+    let mut saved = [0u8; 256];
+    let result = (|| -> Result<()> {
+        unsafe { GetKeyboardState(&mut saved) }?;
+        let mut held = saved;
+        for vk in modifiers.iter().filter_map(|m| modifier_vk(m)) {
+            let left = match vk {
+                v if v == VK_SHIFT => VK_LSHIFT,
+                v if v == VK_MENU => VK_LMENU,
+                v if v == VK_LWIN => VK_LWIN,
+                _ => VK_LCONTROL,
+            };
+            held[vk.0 as usize] |= 0x80;
+            held[left.0 as usize] |= 0x80;
+        }
+        unsafe { SetKeyboardState(&held) }?;
+        let posted = post_key(hwnd, key, modifiers);
+        // The state must hold while the target pulls the key from its queue;
+        // an idle UI thread does that within a few milliseconds.
+        sleep(Duration::from_millis(120));
+        posted
+    })();
+    unsafe {
+        let _ = SetKeyboardState(&saved);
+        let _ = AttachThreadInput(my_thread, their_thread, BOOL(0));
+    }
+    result
+}
