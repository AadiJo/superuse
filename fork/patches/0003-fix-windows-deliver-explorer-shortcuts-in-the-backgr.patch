-pub fn post_key_with_modifier_state(hwnd: u64, key: &str, modifiers: &[&str]) -> Result<()> {
+/// Input windows of XAML islands (Win11 Explorer's address bar, search box and
+/// command bar, other XAML-island hosts). Their input site only reads the
+/// system input queue, so a posted key is dropped.
+const XAML_ISLAND_INPUT_CLASSES: &[&str] = &[
+    "Microsoft.UI.Content.DesktopChildSiteBridge",
+    "InputSiteWindowClass",
+    "Windows.UI.Composition.DesktopWindowContentBridge",
+    "Windows.UI.Input.InputSite.WindowClass",
+];
+
+/// Background key delivery for Win32 targets (`hotkey`, `press_key`).
+///
+/// Posts `key` to the window that has keyboard focus on `hwnd`'s UI
+/// thread(s) (`GetGUIThreadInfo`), e.g. Explorer's file view `DirectUIHWND`
+/// or its inline rename box, and holds `modifiers` in that thread's key
+/// state while the key is handled. Explorer, WinForms and every
+/// `TranslateAccelerator` app read modifiers with `GetKeyState`, so a plain
+/// posted Ctrl+Shift+N arrived as a bare N and reported success.
+///
+/// Errors when the key cannot land: keyboard focus is inside an XAML island,
+/// UIPI blocks the post, or the target thread cannot be attached. Callers
+/// turn that into `background_unavailable` instead of a false success.
+pub fn post_key_background(hwnd: u64, key: &str, modifiers: &[&str]) -> Result<()> {
+    let root = HWND(hwnd as *mut _);
+    let target = focused_descendant(root).unwrap_or(root);
+    if let Some(class) =
+        class_name(target).filter(|class| XAML_ISLAND_INPUT_CLASSES.contains(&class.as_str()))
+    {
+        bail!("keyboard focus is in an XAML island ({class}), which ignores posted keys");
+    }
+    if modifiers.is_empty() {
+        post_key(target.0 as u64, key, modifiers)
+    } else {
+        post_key_with_modifier_state(target.0 as u64, key, modifiers)
+    }
+}
+
+/// [`post_key`] to `hwnd` (the focus window itself) with `modifiers` held
+/// in its thread's key state: posted `WM_KEYDOWN(VK_CONTROL)` does not
+/// change the state `GetKeyState` reads. This thread attaches to the target
+/// thread's input, sets the shared keyboard state, posts the key, waits for
+/// the target to handle it, then restores the state and detaches (the
+/// technique AutoHotkey's ControlSend uses). No foreground change and no
+/// system-wide key state.
+fn post_key_with_modifier_state(hwnd: u64, key: &str, modifiers: &[&str]) -> Result<()> {
     use windows::Win32::System::Threading::{AttachThreadInput, GetCurrentThreadId};
     use windows::Win32::UI::Input::KeyboardAndMouse::{
         GetKeyboardState, SetKeyboardState, VK_LCONTROL, VK_LMENU, VK_LSHIFT, VK_LWIN, VK_MENU,
@@ -450,11 +487,19 @@ pub fn post_key_with_modifier_state(hwnd: u64, key: &str, modifiers: &[&str]) ->
             held[left.0 as usize] |= 0x80;
         }
         unsafe { SetKeyboardState(&held) }?;
-        let posted = post_key(hwnd, key, modifiers);
-        // The state must hold while the target pulls the key from its queue;
-        // an idle UI thread does that within a few milliseconds.
-        sleep(Duration::from_millis(120));
-        posted
+        let started = Instant::now();
+        post_key(hwnd, key, modifiers)?;
+        // The state must hold until the target has pulled the key down from
+        // its queue. A sent WM_NULL is handled at the thread's next
+        // GetMessage, so after round trip j at least j-1 posted messages are
+        // done; the key down is message `modifiers.len() + 1`. A thread that
+        // was busy (Explorer right after a navigation) is covered too. Keep
+        // v2's 120 ms as a floor for loops that peek without removing.
+        for _ in 0..modifiers.len() + 2 {
+            wait_for_message_loop(HWND(hwnd as *mut _))?;
+        }
+        sleep(Duration::from_millis(120).saturating_sub(started.elapsed()));
+        Ok(())
     })();
     unsafe {
         let _ = SetKeyboardState(&saved);
@@ -463,6 +508,32 @@ pub fn post_key_with_modifier_state(hwnd: u64, key: &str, modifiers: &[&str]) ->
     result
 }
 
+/// Return once `hwnd`'s thread is back in its message loop (a sent `WM_NULL`
+/// was handled). Errors after 2 s or at once for a hung UI thread; the key may
+/// then arrive later without its modifiers.
+fn wait_for_message_loop(hwnd: HWND) -> Result<()> {
+    use windows::Win32::UI::WindowsAndMessaging::{SendMessageTimeoutW, SMTO_ABORTIFHUNG, WM_NULL};
+    let mut reply = 0usize;
+    let sent = unsafe {
+        SendMessageTimeoutW(
+            hwnd,
+            WM_NULL,
+            WPARAM(0),
+            LPARAM(0),
+            SMTO_ABORTIFHUNG,
+            2000,
+            Some(&mut reply),
+        )
+    };
+    if sent.0 == 0 {
+        bail!(
+            "the target's UI thread did not get back to its message loop within 2 s, so the \
+             shortcut may arrive without its modifiers"
+        );
+    }
+    Ok(())
+}
