+/// Whether [`run_menu_path`] had to activate the target window.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum MenuForeground {
+    /// Foreground was never touched (or the target already had it).
+    Untouched,
+    /// Activated for the walk, previous foreground restored afterwards.
+    Activated { assisted_retry: bool },
+}
+
+/// Run a menu path on top-level `hwnd_value`, taking foreground only where
+/// the menu needs it. Blocking; shared by `invoke_menu` and by `click` on a
+/// closed drop-down item.
+/// - Win32 menu bar: post the item's `WM_COMMAND` (`win32::menu`).
+/// - Other menus of classic windows (WinForms MenuStrip): posted clicks
+///   (`uia::menu_walks_in_background`).
+/// - Everything else (WPF, XAML, a Win32 menu whose path only exists once
+///   opened): activate the window, walk the menu through UIA, then restore
+///   the previous foreground.
+fn run_menu_path(
+    hwnd_value: u64,
+    path: &[String],
+) -> Result<(MenuForeground, crate::uia::MenuActivation), String> {
+    use windows::Win32::Foundation::HWND;
+    use windows::Win32::UI::WindowsAndMessaging::GetForegroundWindow;
+    if let Some(id) = crate::win32::menu::resolve_command(hwnd_value, path) {
+        let mut pid = 0_u32;
+        unsafe {
+            windows::Win32::UI::WindowsAndMessaging::GetWindowThreadProcessId(
+                HWND(hwnd_value as *mut _),
+                Some(&mut pid),
+            )
+        };
+        let watch = crate::uia::activate::WindowWatch::start(pid);
+        crate::win32::menu::post_command(hwnd_value, id).map_err(|error| error.to_string())?;
+        let changes = watch.settle();
+        return Ok((
+            MenuForeground::Untouched,
+            crate::uia::MenuActivation::Command(id, changes),
+        ));
+    }
+    let hwnd = HWND(hwnd_value as *mut _);
+    let prior = unsafe { GetForegroundWindow() };
+    if prior == hwnd || crate::uia::menu_walks_in_background(hwnd_value) {
+        return crate::uia::invoke_menu_path(hwnd_value, path)
+            .map(|invoked| (MenuForeground::Untouched, invoked));
+    }
+    let assisted_retry = activate_window_for_menu(hwnd)?;
+    std::thread::sleep(std::time::Duration::from_millis(100));
+    let result = crate::uia::invoke_menu_path(hwnd_value, path);
+    if !prior.0.is_null() {
+        let _ = unsafe { crate::input::force_foreground_attached(prior) };
+    }
+    result.map(|invoked| (MenuForeground::Activated { assisted_retry }, invoked))
+}
