@@ -0,0 +1,108 @@
+//! Win32 menu bars (`HMENU`) driven without opening them.
+//!
+//! A Win32 menu bar only opens for the active window, so walking it through
+//! UIA means activating the target. Its items are plain data instead: find the
+//! path by item text and post the item's `WM_COMMAND` to the window, which is
+//! what clicking it would send. No activation, no menu on screen, and a
+//! command that opens a modal dialog runs from the app's own message loop.
+
+use windows::Win32::Foundation::{HWND, LPARAM, WPARAM};
+use windows::Win32::UI::WindowsAndMessaging::{
+    GetMenu, GetMenuItemCount, GetMenuItemInfoW, PostMessageW, HMENU, MENUITEMINFOW, MFS_DISABLED,
+    MFT_SEPARATOR, MIIM_FTYPE, MIIM_ID, MIIM_STATE, MIIM_STRING, MIIM_SUBMENU, WM_COMMAND,
+};
+
+/// Item text as UIA names it: `&` mnemonics removed (`&&` is a literal `&`),
+/// the accelerator after a tab dropped.
+fn display_text(raw: &str) -> String {
+    let label = raw.split('\t').next().unwrap_or_default();
+    let mut out = String::with_capacity(label.len());
+    let mut chars = label.chars().peekable();
+    while let Some(ch) = chars.next() {
+        if ch == '&' {
+            if chars.peek() == Some(&'&') {
+                out.push('&');
+                chars.next();
+            }
+            continue;
+        }
+        out.push(ch);
+    }
+    out.trim().to_owned()
+}
+
+struct Item {
+    text: String,
+    id: u32,
+    submenu: HMENU,
+    enabled: bool,
+}
+
+unsafe fn items(menu: HMENU) -> Vec<Item> {
+    let count = GetMenuItemCount(menu);
+    (0..count.max(0) as u32)
+        .filter_map(|position| {
+            let mut buf = [0u16; 256];
+            let mut info = MENUITEMINFOW {
+                cbSize: std::mem::size_of::<MENUITEMINFOW>() as u32,
+                fMask: MIIM_STRING | MIIM_ID | MIIM_SUBMENU | MIIM_STATE | MIIM_FTYPE,
+                dwTypeData: windows::core::PWSTR(buf.as_mut_ptr()),
+                cch: buf.len() as u32,
+                ..Default::default()
+            };
+            GetMenuItemInfoW(menu, position, true, &mut info).ok()?;
+            if (info.fType & MFT_SEPARATOR).0 != 0 || info.cch == 0 {
+                return None; // separators and owner-drawn items have no text
+            }
+            Some(Item {
+                text: display_text(&String::from_utf16_lossy(&buf[..info.cch as usize])),
+                id: info.wID,
+                submenu: info.hSubMenu,
+                enabled: (info.fState & MFS_DISABLED).0 == 0,
+            })
+        })
+        .collect()
+}
+
+/// Command id of the enabled leaf item at `path` in `hwnd`'s menu bar.
+/// `None` when the window has no Win32 menu bar or the path does not resolve
+/// uniquely to an enabled command in it (for example a submenu the app fills
+/// in only when it opens); the caller then walks the menu through UIA.
+pub fn resolve_command(hwnd: u64, path: &[String]) -> Option<u32> {
+    let mut menu = unsafe { GetMenu(HWND(hwnd as *mut _)) };
+    for (depth, segment) in path.iter().enumerate() {
+        if menu.0.is_null() {
+            return None;
+        }
+        let items = unsafe { items(menu) };
+        let mut matching = items.iter().filter(|item| item.text == *segment);
+        let item = matching.next()?;
+        if matching.next().is_some() || !item.enabled {
+            return None;
+        }
+        let last = depth + 1 == path.len();
+        match (last, item.submenu.0.is_null()) {
+            (true, true) => return Some(item.id),
+            (true, false) => return None,
+            (false, _) => menu = item.submenu,
+        }
+    }
+    None
+}
+
+/// Post the menu command `id` to `hwnd`, as a click on the item would.
+pub fn post_command(hwnd: u64, id: u32) -> anyhow::Result<()> {
+    if let Some(message) = crate::input::post_message_blocked_by_uipi(hwnd) {
+        anyhow::bail!(message);
+    }
+    // wParam: high word 0 (sent by a menu), low word the item id.
+    unsafe {
+        PostMessageW(
+            HWND(hwnd as *mut _),
+            WM_COMMAND,
+            WPARAM(id as usize & 0xffff),
+            LPARAM(0),
+        )
+    }
+    .map_err(|error| anyhow::anyhow!("PostMessage(WM_COMMAND): {error}"))
+}
