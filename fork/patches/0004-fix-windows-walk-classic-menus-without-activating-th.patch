+/// Tool result for a menu path run by [`run_menu_path`].
+fn menu_path_result(
+    invoked: &crate::uia::MenuActivation,
+    foreground: MenuForeground,
+    pid: u32,
+) -> ToolResult {
+    use crate::uia::invoke::InvokeOutcome;
+    use crate::uia::MenuActivation;
+    use cua_driver_core::action_record::{
+        ActionEffect, ActionEvidence, ActionExecutionRecord, ActionTransport, ActualDelivery,
+        EvidenceKind, RequestedDelivery,
+    };
+    let windows = match invoked {
+        MenuActivation::Posted(_, changes) | MenuActivation::Command(_, changes) => {
+            Some(changes.json())
+        }
+        MenuActivation::Uia(_) => None,
+    };
+    let mut result = ToolResult::text(match invoked {
+        MenuActivation::Uia(InvokeOutcome::Returned) => "Resolved the live native menu path and dispatched its final accessibility action; verify the command's semantic effect from fresh state.".to_owned(),
+        MenuActivation::Uia(InvokeOutcome::Dispatched) => {
+            crate::uia::invoke::dispatched_message("the menu path", pid)
+        }
+        MenuActivation::Posted(posted, changes) => format!(
+            "✅ Resolved the live menu path and clicked its final item ({}; classic message loop, no UIA call left running{}). {}",
+            posted.describe(),
+            if foreground == MenuForeground::Untouched { ", window left in the background" } else { "" },
+            changes.sentence(pid)
+        ),
+        MenuActivation::Command(id, changes) => format!(
+            "✅ Resolved the path in the window's Win32 menu bar and posted its WM_COMMAND (id {id}) without opening the menu or activating the window. {}",
+            changes.sentence(pid)
+        ),
+    })
+    .with_action_record(
+        ActionExecutionRecord::builder(
+            ActionEffect::Unverifiable,
+            match invoked {
+                MenuActivation::Posted(..) | MenuActivation::Command(..) => {
+                    ActionTransport::WindowsPostMessage
+                }
+                MenuActivation::Uia(_) => ActionTransport::WindowsUiaInvoke,
+            },
+            RequestedDelivery::Foreground,
+        )
+        .actual_delivery(match foreground {
+            MenuForeground::Untouched => ActualDelivery::Background,
+            MenuForeground::Activated { .. } => ActualDelivery::Foreground,
+        })
+        .evidence(ActionEvidence {
+            kind: EvidenceKind::NativeApiResult,
+            detail: match invoked {
+                MenuActivation::Uia(InvokeOutcome::Returned) => "Every menu hop resolved uniquely and UI Automation accepted the final action",
+                MenuActivation::Uia(InvokeOutcome::Dispatched) => "Every menu hop resolved uniquely; an Invoke was still running at its deadline",
+                MenuActivation::Posted(..) => "Every menu hop resolved uniquely and was clicked with posted window messages",
+                MenuActivation::Command(..) => "The path resolved uniquely to an enabled Win32 menu command, posted as WM_COMMAND",
+            }
+            .into(),
+        })
+        .detail(match foreground {
+            MenuForeground::Untouched => "target was not activated (already foreground, or walked with posted messages)",
+            MenuForeground::Activated { assisted_retry: true } => "target activation required a bounded reserved-key foreground-lock retry",
+            MenuForeground::Activated { assisted_retry: false } => "target was activated for the walk without a foreground-lock retry",
+        })
+        .build()
+        .expect("invoke_menu record is valid"),
+    );
+    if let (Some(windows), Some(Value::Object(map))) = (windows, result.structured_content.as_mut())
+    {
+        map.insert("windows".into(), windows);
+    }
+    result
+}
