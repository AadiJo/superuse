+/// Refusal from the hit test that guards `SendInput` pointer input: real
+/// input at the point would land in a window outside the target's tree, so
+/// none was sent. Tools report it as `target_not_at_point`.
+#[derive(Debug, Clone, Copy)]
+pub struct PointNotOnTarget {
+    pub target: u64,
+    pub x: i32,
+    pub y: i32,
+    /// Top-level window under the point and its pid, if there is one.
+    pub hit: Option<(u64, u32)>,
+}
+
+impl std::fmt::Display for PointNotOnTarget {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "target_not_at_point: screen ({},{}) ", self.x, self.y)?;
+        match self.hit {
+            Some((hwnd, pid)) => write!(f, "is over window 0x{hwnd:x} of pid {pid}")?,
+            None => write!(f, "is not over any window")?,
+        }
+        write!(
+            f,
+            ", not target window 0x{:x} or a window of its UI thread, so the input would \
+             land there. No input was sent. Use a point inside the target window that no \
+             other window covers.",
+            self.target
+        )
+    }
+}
+
+impl std::error::Error for PointNotOnTarget {}
+
+fn top_level_of(hwnd: HWND) -> HWND {
+    let root = unsafe { GetAncestor(hwnd, GA_ROOT) };
+    if root.0.is_null() {
+        hwnd
+    } else {
+        root
+    }
+}
+
+/// `(thread id, pid)` of a window's UI thread.
+fn window_thread(hwnd: HWND) -> (u32, u32) {
+    let mut pid = 0;
+    let thread = unsafe { GetWindowThreadProcessId(hwnd, Some(&mut pid)) };
+    (thread, pid)
+}
+
+/// Top-level window that real pointer input at screen `(x, y)` reaches.
+/// `WindowFromPoint` can return this process's own agent-cursor overlay, which
+/// sits on the point during a click but lets input through (it is
+/// `WS_EX_TRANSPARENT`); the desktop's child lookup skips such windows.
+fn top_level_at(x: i32, y: i32) -> Option<HWND> {
+    use windows::Win32::System::Threading::GetCurrentProcessId;
+    use windows::Win32::UI::WindowsAndMessaging::{GetDesktopWindow, WindowFromPoint};
+    let point = POINT { x, y };
+    let hit = unsafe { WindowFromPoint(point) };
+    if hit.0.is_null() {
+        return None;
+    }
+    let root = top_level_of(hit);
+    if window_thread(root).1 != unsafe { GetCurrentProcessId() } {
+        return Some(root);
+    }
+    let desktop = unsafe { GetDesktopWindow() };
+    let under = unsafe {
+        ChildWindowFromPointEx(
+            desktop,
+            point,
+            CWP_SKIPINVISIBLE | CWP_SKIPDISABLED | CWP_SKIPTRANSPARENT,
+        )
+    };
+    (!under.0.is_null() && under != desktop).then_some(under)
+}
+
+/// Whether real pointer input at screen `(x, y)` lands in `target`'s window
+/// tree: the top-level window there is `target`'s own (so a child window from
+/// another process, such as a WebView2 renderer, counts) or another top-level
+/// window of the same UI thread (its open menu, drop-down list or dialog).
+/// Anything else, such as another app's always-on-top window, the taskbar or
+/// the desktop, would take the input instead. Call it after the target has
+/// been raised, right before `SendInput`.
+fn point_reaches_target(target: HWND, x: i32, y: i32) -> Result<(), PointNotOnTarget> {
+    let root = top_level_of(target);
+    let refusal = |hit: Option<HWND>| PointNotOnTarget {
+        target: root.0 as u64,
+        x,
+        y,
+        hit: hit.map(|hit| (hit.0 as u64, window_thread(hit).1)),
+    };
+    match top_level_at(x, y) {
+        Some(hit) if hit == root || window_thread(hit).0 == window_thread(root).0 => Ok(()),
+        hit => Err(refusal(hit)),
+    }
+}
+
+/// [`point_reaches_target`] after the target was activated or raised, polled
+/// for up to 250 ms. `SetForegroundWindow` on another thread's window brings
+/// it to the top only when that thread handles the activation, so right after
+/// the call the old stacking can still hide the point.
+fn point_reaches_target_after_raise(target: HWND, x: i32, y: i32) -> Result<(), PointNotOnTarget> {
+    let deadline = std::time::Instant::now() + Duration::from_millis(250);
+    loop {
+        match point_reaches_target(target, x, y) {
+            Err(_) if std::time::Instant::now() < deadline => sleep(Duration::from_millis(15)),
+            result => return result,
+        }
+    }
+}
+
+/// Check before the target is activated or raised. The point must be inside
+/// the target's top-level window or already over its tree: raising only
+/// changes the stacking, so any other point can never reach the target. And
+/// an always-on-top window of another app over the point stays above a
+/// target that isn't always-on-top itself. Refusing those here avoids a
+/// pointless foreground change.
+fn point_within_target(target: HWND, x: i32, y: i32) -> Result<(), PointNotOnTarget> {
+    use windows::Win32::Foundation::RECT;
+    use windows::Win32::UI::WindowsAndMessaging::GetWindowRect;
+    let is_topmost =
+        |hwnd: HWND| unsafe { GetWindowLongPtrW(hwnd, GWL_EXSTYLE) } as u32 & WS_EX_TOPMOST.0 != 0;
+    let root = top_level_of(target);
+    let mut rect = RECT::default();
+    let inside = unsafe { GetWindowRect(root, &mut rect) }.is_ok()
+        && x >= rect.left
+        && x < rect.right
+        && y >= rect.top
+        && y < rect.bottom;
+    let Err(refusal) = point_reaches_target(target, x, y) else {
+        return Ok(());
+    };
+    let covered_by_topmost = refusal
+        .hit
+        .is_some_and(|(hit, _)| is_topmost(HWND(hit as *mut _)));
+    if !inside || (covered_by_topmost && !is_topmost(root)) {
+        Err(refusal)
+    } else {
+        Ok(())
+    }
+}
+
