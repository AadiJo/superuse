+    }
+    if delivery != crate::input::delivery::DeliveryMode::Foreground {
+        return Err(MenuPathError::NeedsActivation(match static_miss {
+            Some(reason) => format!(
+                "{reason} in the window's Win32 menu bar; the app may only fill that menu in \
+                 when it opens, and it only opens while the window is active"
+            ),
+            None => format!(
