+/// `background_unavailable` for a menu that needs the window active.
+fn menu_background_unavailable(hwnd: u64, path: &[String], cause: String) -> ToolResult {
+    cua_driver_core::delivery::background_unavailable_result(
+        format!(
+            "invoke_menu cannot run {} without activating the window: {cause}. Nothing was \
+             sent and foreground was not changed. Retry with delivery_mode:\"foreground\" to \
+             activate the window for the walk and restore the previous foreground afterwards.",
+            path.join(" > ")
+        ),
+        "background_unavailable",
+        "this menu only opens while its window is active; retry with \
+         delivery_mode:\"foreground\".",
+        json!({
+            "target_class": crate::input::delivery::read_class_name(hwnd),
+            "cause": cause,
+        }),
+    )
 }
 
