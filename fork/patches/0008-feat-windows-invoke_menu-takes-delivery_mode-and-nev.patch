     }
-    result.map(|invoked| (MenuForeground::Activated { assisted_retry }, invoked))
+    result
+        .map(|invoked| (MenuForeground::Activated { assisted_retry }, invoked))
+        .map_err(MenuPathError::Failed)
+}
