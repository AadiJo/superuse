     let mut last_error = None;
     for &candidate in click_order(control_type, action) {
@@ -253,6 +257,8 @@ pub(crate) unsafe fn select_combo_option(
     host_hwnd: isize,
     value: &str,
 ) -> anyhow::Result<ComboSelect> {
