From efe4121829b568a14ee7c9f07c73ea9cbee79c49 Mon Sep 17 00:00:00 2001
From: Advait Johari <zakethegr8@gmail.com>
Date: Sun, 11 Oct 2026 23:30:51 -0500
Subject: [PATCH 09/13] fix(windows): join the mta before uia calls on blocking
 workers

The fork's UIA entry points (posted activation, closed menu paths, Chromium pattern clicks, combo selection, verified set_value) run on tokio blocking workers and called CoCreateInstance without initializing COM. When no thread keeps the process MTA alive that fails with CO_E_NOTINITIALIZED, and the modal-safe posted route silently fell back to UIA Invoke. Each entry point now joins the MTA first, fire and forget, like walk_tree and uia::scroll do.
---
 .../rust/crates/platform-windows/src/uia/activate.rs  | 11 ++++++++++-
 .../rust/crates/platform-windows/src/uia/mod.rs       |  2 ++
 .../rust/crates/platform-windows/src/uia/patterns.rs  | 10 +++++++++-
 3 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/libs/cua-driver/rust/crates/platform-windows/src/uia/activate.rs b/libs/cua-driver/rust/crates/platform-windows/src/uia/activate.rs
index 8e11b78..f0adb11 100644
--- a/libs/cua-driver/rust/crates/platform-windows/src/uia/activate.rs
+++ b/libs/cua-driver/rust/crates/platform-windows/src/uia/activate.rs
@@ -20,7 +20,9 @@
 use std::time::{Duration, Instant};
 
 use windows::Win32::Foundation::{BOOL, HWND, LPARAM, RECT, TRUE, WPARAM};
-use windows::Win32::System::Com::{CoCreateInstance, CLSCTX_INPROC_SERVER};
+use windows::Win32::System::Com::{
+    CoCreateInstance, CoInitializeEx, CLSCTX_INPROC_SERVER, COINIT_MULTITHREADED,
+};
 use windows::Win32::UI::Accessibility::{
     CUIAutomation, ExpandCollapseState_LeafNode, IUIAutomation, IUIAutomationElement,
     IUIAutomationExpandCollapsePattern, UIA_ButtonControlTypeId, UIA_ExpandCollapsePatternId,
@@ -187,6 +189,11 @@ pub(crate) unsafe fn activation_target(
     elem: &IUIAutomationElement,
     point: Option<(i32, i32)>,
 ) -> Option<PostedActivation> {
+    // Callers run on tokio blocking workers that may never have joined COM;
+    // there CoCreateInstance fails with CO_E_NOTINITIALIZED and the caller
+    // silently took its fallback route. Fire and forget, never uninitialized
+    // (the crate convention, see `uia::scroll`).
+    let _ = CoInitializeEx(None, COINIT_MULTITHREADED);
     let control_type = elem.CurrentControlType().ok()?;
     if !is_activation_control(control_type) || is_submenu_parent(elem) {
         return None;
@@ -202,6 +209,8 @@ pub(crate) unsafe fn posted_click_target(
     elem: &IUIAutomationElement,
     point: Option<(i32, i32)>,
 ) -> Option<PostedActivation> {
+    // Join the MTA first, as in `activation_target`.
+    let _ = CoInitializeEx(None, COINIT_MULTITHREADED);
     let owner = nearest_native_window(elem)?;
     if !is_classic_window(owner.0 as u64) {
         return None;
diff --git a/libs/cua-driver/rust/crates/platform-windows/src/uia/mod.rs b/libs/cua-driver/rust/crates/platform-windows/src/uia/mod.rs
index 30fae38..355543b 100644
--- a/libs/cua-driver/rust/crates/platform-windows/src/uia/mod.rs
+++ b/libs/cua-driver/rust/crates/platform-windows/src/uia/mod.rs
@@ -202,6 +202,8 @@ pub(crate) unsafe fn closed_menu_item_path(elem: &IUIAutomationElement) -> Optio
     use windows::Win32::UI::Accessibility::{
         UIA_MenuBarControlTypeId, UIA_MenuControlTypeId, UIA_MenuItemControlTypeId,
     };
+    // Join the MTA first, as in `activate::activation_target`.
+    let _ = CoInitializeEx(None, COINIT_MULTITHREADED);
     if elem.CurrentControlType().ok()? != UIA_MenuItemControlTypeId {
         return None;
     }
