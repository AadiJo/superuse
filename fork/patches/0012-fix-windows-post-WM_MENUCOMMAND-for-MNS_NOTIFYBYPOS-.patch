         MenuActivation::Posted(posted, changes) => (posted.describe(), changes),
-        MenuActivation::Command(id, changes) => (format!("posted WM_COMMAND {id}"), changes),
+        MenuActivation::Command(posted, changes) => {
+            (format!("posted {}", posted.describe()), changes)
+        }
         MenuActivation::Uia(_) => ("UI Automation".to_owned(), Default::default()),
     };
     Ok(BackgroundElementClick::Posted {
@@ -9639,7 +9641,8 @@ enum MenuPathError {
 }
 
 /// Run a menu path on top-level `hwnd_value`. Blocking.
-/// - Win32 menu bar: post the item's `WM_COMMAND` (`win32::menu`).
+/// - Win32 menu bar: post the item's `WM_COMMAND` or `WM_MENUCOMMAND`
+///   (`win32::menu`).
 /// - Other menus of classic windows (WinForms MenuStrip): posted clicks
 ///   (`uia::menu_walks_in_background`).
 /// - Everything else (WPF, XAML, a Win32 menu whose path only exists once
@@ -9657,7 +9660,7 @@ fn run_menu_path(
     use windows::Win32::Foundation::HWND;
     use windows::Win32::UI::WindowsAndMessaging::GetForegroundWindow;
     let static_miss = match crate::win32::menu::resolve_command(hwnd_value, path) {
-        Ok(id) => {
+        Ok(command) => {
             let mut pid = 0_u32;
             unsafe {
                 windows::Win32::UI::WindowsAndMessaging::GetWindowThreadProcessId(
@@ -9666,12 +9669,12 @@ fn run_menu_path(
                 )
             };
             let watch = crate::uia::activate::WindowWatch::start(pid);
-            crate::win32::menu::post_command(hwnd_value, id)
+            let posted = crate::win32::menu::post_command(hwnd_value, command)
                 .map_err(|error| MenuPathError::Failed(error.to_string()))?;
             let changes = watch.settle();
             return Ok((
                 MenuForeground::Untouched,
-                crate::uia::MenuActivation::Command(id, changes),
+                crate::uia::MenuActivation::Command(posted, changes),
             ));
         }
         Err(MenuMiss::NoMenuBar) => None,
@@ -9743,9 +9746,10 @@ impl Tool for InvokeMenuTool {
                 description: format!(
                     "{} On Windows, `delivery_mode` decides whether the window may be \
                      activated. \"background\" (default) never activates it: Win32 menu bars \
-                     get the item's WM_COMMAND and classic (WinForms) menus get posted clicks; \
-                     menus that only open while the window is active (WPF, XAML, Win32 items \
-                     missing or disabled in the static menu) return background_unavailable. \
+                     get the item's WM_COMMAND (or WM_MENUCOMMAND), and classic (WinForms) \
+                     menus get posted clicks; menus that only open while the window is active \
+                     (WPF, XAML, Win32 items missing or disabled in the static menu) return \
+                     background_unavailable. \
                      \"foreground\" activates the window for the walk and restores the \
                      previous foreground.",
                     contract.description
@@ -9832,8 +9836,9 @@ fn menu_path_result(
             if foreground == MenuForeground::Untouched { ", window left in the background" } else { "" },
             changes.sentence(pid)
         ),
-        MenuActivation::Command(id, changes) => format!(
-            "✅ Resolved the path in the window's Win32 menu bar and posted its WM_COMMAND (id {id}) without opening the menu or activating the window. {}",
+        MenuActivation::Command(posted, changes) => format!(
+            "✅ Resolved the path in the window's Win32 menu bar and posted its {} without opening the menu or activating the window. {}",
+            posted.describe(),
             changes.sentence(pid)
         ),
     })
@@ -9862,7 +9867,7 @@ fn menu_path_result(
                 MenuActivation::Uia(InvokeOutcome::Returned) => "Every menu hop resolved uniquely and UI Automation accepted the final action",
                 MenuActivation::Uia(InvokeOutcome::Dispatched) => "Every menu hop resolved uniquely; an Invoke was still running at its deadline",
                 MenuActivation::Posted(..) => "Every menu hop resolved uniquely and was clicked with posted window messages",
-                MenuActivation::Command(..) => "The path resolved uniquely to an enabled Win32 menu command, posted as WM_COMMAND",
+                MenuActivation::Command(..) => "The path resolved uniquely to an enabled Win32 menu command, posted as WM_COMMAND or WM_MENUCOMMAND",
             }
             .into(),
         })
diff --git a/libs/cua-driver/rust/crates/platform-windows/src/uia/mod.rs b/libs/cua-driver/rust/crates/platform-windows/src/uia/mod.rs
index 355543b..adc4129 100644
--- a/libs/cua-driver/rust/crates/platform-windows/src/uia/mod.rs
+++ b/libs/cua-driver/rust/crates/platform-windows/src/uia/mod.rs
@@ -174,9 +174,10 @@ pub enum MenuActivation {
     /// so a modal dialog it opens cannot hold a UIA call (see `activate`),
     /// with the windows of the app that opened or closed right after it.
     Posted(activate::PostedActivation, activate::WindowChanges),
-    /// `WM_COMMAND` posted for a Win32 menu bar item (`crate::win32::menu`),
-    /// without opening the menu, with the windows that opened or closed.
-    Command(u32, activate::WindowChanges),
+    /// `WM_COMMAND` or `WM_MENUCOMMAND` posted for a Win32 menu bar item
+    /// (`crate::win32::menu`), without opening the menu, with the windows
