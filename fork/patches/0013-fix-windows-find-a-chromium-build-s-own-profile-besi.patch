diff --git a/libs/cua-driver/rust/crates/platform-windows/src/browser_platform.rs b/libs/cua-driver/rust/crates/platform-windows/src/browser_platform.rs
index 65db115..26a8e29 100644
--- a/libs/cua-driver/rust/crates/platform-windows/src/browser_platform.rs
+++ b/libs/cua-driver/rust/crates/platform-windows/src/browser_platform.rs
@@ -796,14 +796,36 @@ async fn browser_command_line(pid: u32) -> Result<String, BrowserRefusal> {
     Ok(command_line)
 }
 
+/// The default profile of a Chromium build installed as `<root>\Application\<exe>` is
+/// `<root>\User Data`, when that folder exists. Builds that keep Chrome's exe name, such as
+/// Helium (`%LOCALAPPDATA%\imput\Helium\Application\chrome.exe`), are otherwise classified
+/// as Google Chrome and looked up in Google's folder. This only locates the port file:
+/// `active_port_endpoint` still proves the listener belongs to the exact process.
+fn install_sibling_user_data_dir(command_line: &str) -> Option<PathBuf> {
+    let exe = PathBuf::from(parse_windows_command_line(command_line).into_iter().next()?);
+    if !is_windows_absolute_path(&exe) {
+        return None;
+    }
+    let app_dir = exe.parent()?;
+    if !app_dir.file_name()?.to_string_lossy().eq_ignore_ascii_case("Application") {
+        return None;
+    }
+    let candidate = app_dir.parent()?.join("User Data");
+    candidate.is_dir().then_some(candidate)
+}
+
 async fn active_port_endpoint(
     pid: u32,
     product: BrowserProduct,
 ) -> Result<Option<OwnedEndpoint>, BrowserRefusal> {
-    let default = default_user_data_dir(product);
-    let user_data_dir = match browser_command_line(pid).await {
-        Ok(command_line) => user_data_dir_from_command_line(&command_line, default.clone())?,
-        Err(_) => default,
+    let command_line = browser_command_line(pid).await.ok();
+    let default = command_line
+        .as_deref()
+        .and_then(install_sibling_user_data_dir)
+        .or_else(|| default_user_data_dir(product));
+    let user_data_dir = match command_line.as_deref() {
+        Some(command_line) => user_data_dir_from_command_line(command_line, default.clone())?,
+        None => default,
     };
     let Some(user_data_dir) = user_data_dir else {
         return Ok(None);
