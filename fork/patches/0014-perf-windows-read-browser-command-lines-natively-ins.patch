+/// Read `pid`'s command line from its process parameters with
+/// `NtQueryInformationProcess(ProcessCommandLineInformation)` (Windows 8.1+).
+/// This is the string WMI's `Win32_Process.CommandLine` reports, read in
+/// microseconds: every browser mutation re-proves the endpoint, and a
+/// PowerShell process per read cost ~400 ms each time. `None` when the process
+/// can't be opened for limited query (another user's or a protected process).
+fn native_command_line(pid: u32) -> Option<String> {
+    use windows::Wdk::System::Threading::{
+        NtQueryInformationProcess, ProcessCommandLineInformation,
+    };
+    use windows::Win32::Foundation::UNICODE_STRING;
+
+    let handle = unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid) }.ok()?;
+    let mut needed = 0u32;
+    // The sizing call fails with STATUS_INFO_LENGTH_MISMATCH and reports the size.
+    let _ = unsafe {
+        NtQueryInformationProcess(
+            handle,
+            ProcessCommandLineInformation,
+            std::ptr::null_mut(),
+            0,
+            &mut needed,
+        )
+    };
+    let header = std::mem::size_of::<UNICODE_STRING>();
+    let bytes = (needed as usize).clamp(header, 1 << 20);
+    // u64 storage keeps the UNICODE_STRING header aligned.
+    let mut buffer = vec![0u64; bytes.div_ceil(8)];
+    let status = unsafe {
+        NtQueryInformationProcess(
+            handle,
+            ProcessCommandLineInformation,
+            buffer.as_mut_ptr().cast(),
+            (buffer.len() * 8) as u32,
+            &mut needed,
+        )
+    };
+    let _ = unsafe { CloseHandle(handle) };
+    if status.is_err() {
+        return None;
+    }
+    let string = unsafe { &*buffer.as_ptr().cast::<UNICODE_STRING>() };
+    let start = buffer.as_ptr() as usize;
+    let text = string.Buffer.0 as usize;
+    let len = usize::from(string.Length);
+    // The kernel writes the characters right after the header, inside `buffer`.
+    if string.Buffer.is_null() || text < start || text + len > start + buffer.len() * 8 {
+        return None;
+    }
+    let chars = unsafe { std::slice::from_raw_parts(string.Buffer.0, len / 2) };
+    Some(String::from_utf16_lossy(chars))
+}
+
 async fn browser_command_line(pid: u32) -> Result<String, BrowserRefusal> {
+    if let Some(command_line) = native_command_line(pid) {
+        let command_line = command_line.trim();
+        if !command_line.is_empty() {
+            return Ok(command_line.to_owned());
+        }
+    }
+    powershell_command_line(pid).await
+}
