+/// Executable file name (`chrome.exe`) of a running `pid`, read from the
+/// process itself. Classification runs on every browser mutation, and a
+/// Toolhelp snapshot of every process costs ~10 ms. `None` when the process
+/// can't be opened for limited query or has exited; callers then fall back
+/// to the snapshot.
+fn live_process_executable_name(pid: u32) -> Option<String> {
+    use windows::Win32::System::Threading::GetExitCodeProcess;
+    const STILL_ACTIVE: u32 = 259;
+
+    let handle = unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid) }.ok()?;
+    let mut exit_code = 0u32;
+    let running =
+        unsafe { GetExitCodeProcess(handle, &mut exit_code) }.is_ok() && exit_code == STILL_ACTIVE;
+    let mut path_buf = [0u16; 1024];
+    let mut path_len = path_buf.len() as u32;
+    let path = running
+        .then(|| unsafe {
+            QueryFullProcessImageNameW(
+                handle,
+                PROCESS_NAME_FORMAT(0),
+                windows::core::PWSTR(path_buf.as_mut_ptr()),
+                &mut path_len,
+            )
+        })
+        .and_then(Result::ok)
+        .map(|()| String::from_utf16_lossy(&path_buf[..path_len as usize]));
+    let _ = unsafe { CloseHandle(handle) };
+    path?
+        .rsplit(['\\', '/'])
+        .next()
+        .filter(|name| !name.is_empty())
+        .map(str::to_owned)
+}
