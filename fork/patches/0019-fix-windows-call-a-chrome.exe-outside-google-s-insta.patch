+fn live_process_image_path(pid: u32) -> Option<String> {
     use windows::Win32::System::Threading::GetExitCodeProcess;
     const STILL_ACTIVE: u32 = 259;
 
@@ -1093,11 +1092,14 @@ fn live_process_executable_name(pid: u32) -> Option<String> {
         .and_then(Result::ok)
         .map(|()| String::from_utf16_lossy(&path_buf[..path_len as usize]));
     let _ = unsafe { CloseHandle(handle) };
-    path?
-        .rsplit(['\\', '/'])
-        .next()
-        .filter(|name| !name.is_empty())
-        .map(str::to_owned)
+    path.filter(|path| !path.is_empty())
+}
+
+/// Google installs Chrome under `...\Google\Chrome\`, `Chrome Beta`,
+/// `Chrome Dev` or `Chrome SxS` (Canary). Other Chromium builds that keep the
+/// `chrome.exe` name, such as Helium, live elsewhere and are not Google Chrome.
+fn is_google_chrome_install(image_path: &str) -> bool {
+    image_path.to_ascii_lowercase().contains("\\google\\chrome")
 }
 
 fn canonical_process_executable(path: String) -> String {
@@ -2255,8 +2257,12 @@ impl BrowserPlatform for WindowsBrowserPlatform {
