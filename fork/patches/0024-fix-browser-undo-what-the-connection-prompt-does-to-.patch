+/// The parts of the user's desktop a browser connection prompt disturbs: the browser restores a
+/// minimized window to show the prompt, the prompt takes the foreground, and closing it activates
+/// the browser window.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct DesktopState {
+    pub minimized: bool,
+    /// The native window that had the foreground, if any.
+    pub foreground: Option<u64>,
+}
