+/// Close every consent prompt open on the browser window `hwnd`, which Chromium treats as Cancel,
+/// and wait (bounded) for them to go. Prompts are found in the window's accessibility tree, then
+/// matched to their own windows by exact title among the top-level windows `hwnd` owns in the same
+/// process, so the browser's other popups are left alone. Returns how many it closed.
+pub fn deny_open_prompts(pid: u32, hwnd: u64) -> usize {
+    use windows::Win32::Foundation::{BOOL, LPARAM, TRUE, WPARAM};
+    use windows::Win32::UI::WindowsAndMessaging::{
+        EnumWindows, GetWindow, GetWindowTextW, IsWindow, PostMessageW, GW_OWNER, WM_CLOSE,
+    };
+    struct Search {
+        owner: HWND,
+        pid: u32,
+        titles: Vec<String>,
+        found: Vec<HWND>,
+    }
+    unsafe extern "system" fn visit(window: HWND, data: LPARAM) -> BOOL {
+        let search = &mut *(data.0 as *mut Search);
+        let mut window_pid = 0u32;
+        GetWindowThreadProcessId(window, Some(&mut window_pid));
+        if window_pid == search.pid && GetWindow(window, GW_OWNER).ok() == Some(search.owner) {
+            let mut text = [0u16; 512];
+            let len = GetWindowTextW(window, &mut text).max(0) as usize;
+            let title = String::from_utf16_lossy(&text[..len]);
+            if search.titles.contains(&title) {
+                search.found.push(window);
+            }
+        }
+        TRUE
+    }
+
+    if prove_window_owner(hwnd, pid).is_err() {
+        return 0;
+    }
+    let tree = ConsentNodes(crate::uia::walk_tree(hwnd, None).nodes);
+    let titles: Vec<String> = native_prompt_surfaces(&tree.0)
+        .into_iter()
+        .filter_map(|(root, _)| node_name(&tree.0[root]).map(str::to_owned))
+        .collect();
+    drop(tree);
+    if titles.is_empty() {
+        return 0;
+    }
+    let mut search = Search {
+        owner: HWND(hwnd as *mut _),
+        pid,
+        titles,
+        found: Vec::new(),
+    };
+    unsafe {
+        let _ = EnumWindows(Some(visit), LPARAM(&mut search as *mut Search as isize));
+        for window in &search.found {
+            let _ = PostMessageW(*window, WM_CLOSE, WPARAM(0), LPARAM(0));
+        }
+        // Closing a prompt activates the browser window; callers restore the foreground after.
+        let deadline = Instant::now() + Duration::from_secs(1);
+        while search.found.iter().any(|window| IsWindow(*window).as_bool())
+            && Instant::now() < deadline
+        {
+            std::thread::sleep(Duration::from_millis(25));
+        }
+    }
+    search.found.len()
+}
