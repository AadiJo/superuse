+    async fn deny_open_consent_prompts(&self, pid: i64, window_id: u64) {
+        let Ok(pid) = u32::try_from(pid) else {
+            return;
+        };
+        let _ = tokio::task::spawn_blocking(move || {
+            crate::browser_consent_ui::deny_open_prompts(pid, window_id)
+        })
+        .await;
+    }
+
+    async fn desktop_state(&self, window_id: u64) -> DesktopState {
+        use windows::Win32::{
+            Foundation::HWND,
+            UI::WindowsAndMessaging::{GetForegroundWindow, IsIconic},
+        };
+        unsafe {
+            let foreground = GetForegroundWindow();
+            DesktopState {
+                minimized: IsIconic(HWND(window_id as isize as *mut _)).as_bool(),
+                foreground: (!foreground.0.is_null()).then_some(foreground.0 as usize as u64),
+            }
+        }
+    }
+
+    async fn restore_desktop_state(&self, window_id: u64, before: DesktopState) {
+        // ShowWindow and AttachThreadInput wait on the browser's UI thread; keep them off the runtime.
+        let _ = tokio::task::spawn_blocking(move || unsafe {
+            use windows::Win32::{
+                Foundation::HWND,
+                UI::WindowsAndMessaging::{
+                    GetForegroundWindow, GetWindowThreadProcessId, IsIconic, IsWindow, ShowWindow,
+                    SW_SHOWMINNOACTIVE,
+                },
+            };
+            let hwnd = HWND(window_id as isize as *mut _);
+            if before.minimized && !IsIconic(hwnd).as_bool() {
+                let _ = ShowWindow(hwnd, SW_SHOWMINNOACTIVE);
+            }
+            let Some(previous) = before.foreground.map(|id| HWND(id as usize as *mut _)) else {
+                return;
+            };
+            let current = GetForegroundWindow();
+            if current == previous || !IsWindow(previous).as_bool() {
+                return;
+            }
+            // Only take the foreground back from the browser (its prompt, or the window the prompt
+            // activated on closing). A different app means the user moved on; leave it.
+            let (mut browser_pid, mut current_pid) = (0u32, 0u32);
+            GetWindowThreadProcessId(hwnd, Some(&mut browser_pid));
+            GetWindowThreadProcessId(current, Some(&mut current_pid));
+            if browser_pid != 0 && current_pid == browser_pid {
+                // Attaching to the browser's input queue alone is refused here; the no-name key
+                // fallback is what gets the foreground back.
+                let (restored, _) = crate::input::force_foreground_assisted(previous);
+                tracing::debug!(target: "browser.desktop", restored, "returned the foreground after the connection prompt");
+            }
+        })
+        .await;
+    }
