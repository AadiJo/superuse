+    /// The parts of `self` that `cover` doesn't overlap: up to four rects.
+    fn minus(self, cover: DirtyRect) -> Vec<DirtyRect> {
+        let (x0, y0) = (self.x0.max(cover.x0), self.y0.max(cover.y0));
+        let (x1, y1) = (self.x1.min(cover.x1), self.y1.min(cover.y1));
+        if x0 >= x1 || y0 >= y1 {
+            return vec![self];
+        }
+        let bands = [
+            DirtyRect { y1: y0, ..self },             // above the overlap
+            DirtyRect { y0: y1, ..self },             // below it
+            DirtyRect { y0, y1, x1: x0, ..self },     // left of it
+            DirtyRect { y0, y1, x0: x1, ..self },     // right of it
+        ];
+        bands
+            .into_iter()
+            .filter(|r| r.x1 > r.x0 && r.y1 > r.y0)
+            .collect()
+    }
 }
 
