+    /// Zero the pixmap pixels inside `r` that no rect in `keep` covers (all clamped).
+    fn clear_outside(&mut self, r: DirtyRect, keep: &[DirtyRect]) {
+        let w = self.w as usize;
+        let data = self.pixmap.data_mut();
+        let mut clear = |y: i32, x0: i32, x1: i32| {
+            let row = y as usize * w;
+            data[(row + x0 as usize) * 4..(row + x1 as usize) * 4].fill(0);
+        };
+        let mut spans: Vec<(i32, i32)> = Vec::new();
+        for y in r.y0..r.y1 {
+            spans.clear();
+            spans.extend(
+                keep.iter()
+                    .filter(|k| k.y0 <= y && y < k.y1)
+                    .map(|k| (k.x0.max(r.x0), k.x1.min(r.x1)))
+                    .filter(|(x0, x1)| x0 < x1),
+            );
+            spans.sort_unstable();
+            let mut x = r.x0;
+            for &(x0, x1) in &spans {
+                if x0 > x {
+                    clear(y, x, x0);
+                }
+                x = x.max(x1);
+            }
+            if x < r.x1 {
+                clear(y, x, r.x1);
+            }
+        }
+    }
