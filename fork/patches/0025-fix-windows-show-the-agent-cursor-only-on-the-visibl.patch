+
+// ── Clip each cursor to its window ────────────────────────────────────────
+//
+// The overlay is one full-screen layer pinned a z-slot above the window a
+// cursor drives. On its own it paints over the desktop around that window,
+// and over any window above it that the 80 ms z-order pin hasn't caught up
+// with, such as a full-screen app the user switches to while the agent works.
+// So each pinned cursor only keeps the pixels that land on the part of its
+// window the user can see. Windows-only: this fork ships the Windows driver.
+
+/// Overlay-local rects where each pinned window is visible, by window id.
+#[cfg(target_os = "windows")]
+type Clips = HashMap<u64, Vec<DirtyRect>>;
+
+/// Visible rects for every revealed cursor's pinned window. Cursors without a
+/// pinned window paint unclipped, as before.
+#[cfg(target_os = "windows")]
+fn cursor_clips(map: &RenderMap) -> Clips {
+    let screen = &map.platform;
+    map.cursors
+        .values()
+        .filter(|rs| rs.core.is_revealed())
+        .filter_map(|rs| rs.core.pinned_wid)
+        .map(|wid| (wid, unsafe { visible_rects(wid, screen.virt_x, screen.virt_y) }))
+        .collect()
+}
+
+/// Window `wid`'s frame minus every window above it that covers it, in
+/// overlay-local pixels. Empty when it's closed, hidden, minimized or cloaked
+/// (another virtual desktop).
+#[cfg(target_os = "windows")]
+unsafe fn visible_rects(wid: u64, virt_x: i32, virt_y: i32) -> Vec<DirtyRect> {
+    use windows::Win32::Foundation::HWND;
+    use windows::Win32::UI::WindowsAndMessaging::{
+        GetWindow, GetWindowThreadProcessId, IsWindow, GW_HWNDPREV,
+    };
+    let target = HWND(wid as *mut _);
+    if !IsWindow(target).as_bool() || !window_shows(target) {
+        return Vec::new();
+    }
+    let Some(frame) = frame_rect(target) else {
+        return Vec::new();
+    };
+    let mut pid = 0u32;
+    GetWindowThreadProcessId(target, Some(&mut pid));
+    let mut visible = vec![frame];
+    let mut above = GetWindow(target, GW_HWNDPREV).unwrap_or(HWND(std::ptr::null_mut()));
+    while !above.0.is_null() && !visible.is_empty() {
+        if covers(above, target, pid) {
+            if let Some(cover) = frame_rect(above) {
+                visible = visible.into_iter().flat_map(|r| r.minus(cover)).collect();
+            }
+        }
+        above = GetWindow(above, GW_HWNDPREV).unwrap_or(HWND(std::ptr::null_mut()));
+    }
+    visible
+        .into_iter()
+        .map(|r| DirtyRect {
+            x0: r.x0 - virt_x,
+            y0: r.y0 - virt_y,
+            x1: r.x1 - virt_x,
+            y1: r.y1 - virt_y,
+        })
+        .collect()
+}
+
+/// Shown on screen: visible, not minimized, not cloaked.
+#[cfg(target_os = "windows")]
+unsafe fn window_shows(h: windows::Win32::Foundation::HWND) -> bool {
+    use windows::Win32::UI::WindowsAndMessaging::{IsIconic, IsWindowVisible};
+    IsWindowVisible(h).as_bool()
+        && !IsIconic(h).as_bool()
+        && !crate::uia::windows_enum::window_is_cloaked(h)
+}
+
+/// Whether `h`, stacked above `target`, hides what's under it. These don't:
+/// - click-through windows (`WS_EX_TRANSPARENT`), including this overlay;
+/// - layered no-activate overlays, like the NVIDIA overlay, which spans the
+///   screen but is transparent where it shows nothing;
+/// - windows that belong to the target: ones it owns (dialogs), and windows
+///   of its process that have no taskbar button (menus, drop-downs, tooltips).
+///   Another top-level window of the same process, such as a second browser
+///   window the user made full screen, still covers.
+#[cfg(target_os = "windows")]
+unsafe fn covers(
+    h: windows::Win32::Foundation::HWND,
+    target: windows::Win32::Foundation::HWND,
+    target_pid: u32,
+) -> bool {
+    use windows::Win32::UI::WindowsAndMessaging::{
+        GetWindow, GetWindowLongPtrW, GetWindowThreadProcessId, GWL_EXSTYLE, GW_OWNER,
+        WS_EX_APPWINDOW, WS_EX_LAYERED, WS_EX_NOACTIVATE, WS_EX_TOOLWINDOW, WS_EX_TRANSPARENT,
+    };
+    if !window_shows(h) {
+        return false;
+    }
+    let ex = GetWindowLongPtrW(h, GWL_EXSTYLE) as u32;
+    if ex & WS_EX_TRANSPARENT.0 != 0 || ex & (WS_EX_LAYERED.0 | WS_EX_NOACTIVATE.0) == (WS_EX_LAYERED.0 | WS_EX_NOACTIVATE.0) {
+        return false;
+    }
+    let owner = GetWindow(h, GW_OWNER).ok().filter(|o| !o.0.is_null());
+    let mut o = owner;
+    while let Some(w) = o {
+        if w == target {
+            return false;
+        }
+        o = GetWindow(w, GW_OWNER).ok().filter(|n| !n.0.is_null());
+    }
+    let mut pid = 0u32;
+    GetWindowThreadProcessId(h, Some(&mut pid));
+    let taskbar_button =
+        owner.is_none() && (ex & WS_EX_APPWINDOW.0 != 0 || ex & WS_EX_TOOLWINDOW.0 == 0);
+    pid != target_pid || taskbar_button
+}
+
+/// The window's visible frame in screen pixels, without the invisible resize
+/// border (DWM extended frame bounds, else the window rect).
+#[cfg(target_os = "windows")]
+unsafe fn frame_rect(h: windows::Win32::Foundation::HWND) -> Option<DirtyRect> {
+    use windows::Win32::Foundation::RECT;
+    use windows::Win32::Graphics::Dwm::{DwmGetWindowAttribute, DWMWA_EXTENDED_FRAME_BOUNDS};
+    use windows::Win32::UI::WindowsAndMessaging::GetWindowRect;
+    let mut r = RECT::default();
+    let dwm = DwmGetWindowAttribute(
+        h,
+        DWMWA_EXTENDED_FRAME_BOUNDS,
+        &mut r as *mut RECT as *mut _,
+        std::mem::size_of::<RECT>() as u32,
+    );
+    if dwm.is_err() || r.right <= r.left || r.bottom <= r.top {
+        GetWindowRect(h, &mut r).ok()?;
+    }
+    (r.right > r.left && r.bottom > r.top).then_some(DirtyRect {
+        x0: r.left,
+        y0: r.top,
+        x1: r.right,
+        y1: r.bottom,
+    })
 }
 
